{
  "name": "n8n-nodes-mammouth",
  "version": "0.2.1",
  "description": "Mammouth API node for n8n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mammouth-ai/n8n-integration.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "n8n-community-node-package"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/MammouthApi.credentials.js"
    ],
    "nodes": [
      "dist/MammouthAi.node.js",
      "dist/LmChatMammouth.node.js"
    ]
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.42.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@langchain/core": "1.2.0",
    "@langchain/openai": "1.4.4"
  }
}
