{
	"name": "n8n-nodes-mammouth",
	"version": "0.1.0",
	"private": true,
	"description": "Private Mammouth API node for n8n",
	"license": "UNLICENSED",
	"keywords": ["n8n-community-node-package"],
	"files": ["dist"],
	"scripts": {
		"build": "node scripts/build.cjs",
		"test": "npm run build && node --test tests/*.test.cjs",
		"prepack": "npm run build"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": ["dist/MammouthApi.credentials.js"],
		"nodes": ["dist/MammouthAi.node.js"]
	},
	"engines": { "node": ">=22" },
	"peerDependencies": { "n8n-workflow": "^2.16.0" },
	"devDependencies": {
		"@types/node": "22.20.4",
		"n8n-workflow": "2.16.0",
		"typescript": "5.9.3"
	}
}